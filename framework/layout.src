// ---- layout ----
func is_row(i) { return gi(i, E_DIR) == 1 }

// Sizes flow up, width constraints flow down (maxw): a wrapped paragraph
// needs to know how wide it may be before it knows how tall it is. In a row,
// children that grow are measured last, against the width the fixed ones leave.
func measure(i, maxw) {
    w := 0.0
    h := 0.0
    if gf(i, E_FW) >= 0.0 { maxw = gf(i, E_FW) }
    if gi(i, E_KIND) == 1 {
        t := gi(i, E_TXT)
        sz := gf(i, E_SIZE)
        fc := gi(i, E_FACE)
        if (gi(i, E_FLAGS) & F_WRAP) != 0 {
            h = mdk_text_wrap_h(t, sz, fc, maxw)
            w = mdk_last_wrap_w()
            sf(i, E_MAXW, maxw)
        } else {
            w = mdk_text_w(t, sz, fc)
            h = mdk_line_h(sz, fc)
            sf(i, E_MAXW, 0.0)
        }
    } else {
        main := 0.0
        cross := 0.0
        n := 0
        r := is_row(i)
        inner := maxw - gf(i, E_PL) - gf(i, E_PR)
        left := inner
        left_share := 0.0
        late_grow := 0.0
        pass := 0
        while pass < 2 {
            c := gi(i, E_FIRST)
            while c >= 0 {
                f := gi(c, E_FLAGS)
                late := r && grow_of(c, r) > 0.0
                if (f & F_ABS) != 0 {
                    if pass == 0 { measure(c, inner) }
                } else if (pass == 0 && !late) || (pass == 1 && late) {
                    if pass == 0 { measure(c, inner) } else { measure(c, left_share * grow_of(c, r) / late_grow) }
                    cw := gf(c, E_W)
                    ch := gf(c, E_H)
                    if r {
                        main = main + cw
                        left = left - cw
                        if ch > cross { cross = ch }
                    } else {
                        main = main + ch
                        if cw > cross { cross = cw }
                    }
                    n = n + 1
                }
                c = gi(c, E_NEXT)
            }
            if pass == 0 && r {
                // growing children share what the fixed ones and the gaps leave
                nl := 0
                c2 := gi(i, E_FIRST)
                while c2 >= 0 {
                    if (gi(c2, E_FLAGS) & F_ABS) == 0 && grow_of(c2, r) > 0.0 {
                        late_grow = late_grow + grow_of(c2, r)
                        nl = nl + 1
                    }
                    c2 = gi(c2, E_NEXT)
                }
                if n + nl > 1 { left = left - gf(i, E_GAP) * float(n + nl - 1) }
                if left < 0.0 { left = 0.0 }
                left_share = left
                if late_grow == 0.0 { late_grow = 1.0 }
            }
            pass = pass + 1
        }
        if n > 1 { main = main + gf(i, E_GAP) * float(n - 1) }
        if r { w = main  h = cross } else { w = cross  h = main }
        w = w + gf(i, E_PL) + gf(i, E_PR)
        h = h + gf(i, E_PT) + gf(i, E_PB)
    }
    if gf(i, E_FW) >= 0.0 { w = gf(i, E_FW) }
    if gf(i, E_FH) >= 0.0 { h = gf(i, E_FH) }
    sf(i, E_W, w)
    sf(i, E_H, h)
}

// main-axis grow factor of child c inside a container laid out along r
func grow_of(c, r) {
    g := gf(c, E_GROW)
    f := gi(c, E_FLAGS)
    if r && (f & F_FILLW) != 0 && g == 0.0 { g = 1.0 }
    if !r && (f & F_FILLH) != 0 && g == 0.0 { g = 1.0 }
    return g
}

func stretches(c, r, a) {
    f := gi(c, E_FLAGS)
    if a == A_STRETCH { return true }
    if r { return (f & F_FILLH) != 0 }
    return (f & F_FILLW) != 0
}

func place(i, x, y, w, h) {
    sf(i, E_X, x)
    sf(i, E_Y, y)
    sf(i, E_W, w)
    sf(i, E_H, h)
    if gi(i, E_KIND) == 1 { return }
    r := is_row(i)
    ix := x + gf(i, E_PL)
    iy := y + gf(i, E_PT)
    iw := w - gf(i, E_PL) - gf(i, E_PR)
    ih := h - gf(i, E_PT) - gf(i, E_PB)
    imain := ih
    icross := iw
    if r { imain = iw  icross = ih }
    used := 0.0
    content := 0.0
    tgrow := 0.0
    n := 0
    c := gi(i, E_FIRST)
    while c >= 0 {
        if (gi(c, E_FLAGS) & F_ABS) == 0 {
            // growing children have a zero basis (CSS flex: 1): they split
            // the free space evenly instead of keeping their content size
            if r { content = content + gf(c, E_W) } else { content = content + gf(c, E_H) }
            if grow_of(c, r) == 0.0 {
                if r { used = used + gf(c, E_W) } else { used = used + gf(c, E_H) }
            }
            tgrow = tgrow + grow_of(c, r)
            n = n + 1
        }
        c = gi(c, E_NEXT)
    }
    g := gf(i, E_GAP)
    if n > 1 { used = used + g * float(n - 1) }
    if n > 1 { content = content + g * float(n - 1) }
    sf(i, E_CONTENT, content + gf(i, E_PT) + gf(i, E_PB))
    free := imain - used
    if free < 0.0 { free = 0.0 }
    pos := 0.0 - gf(i, E_SCROLL)
    j := gi(i, E_JUST)
    if tgrow == 0.0 {
        if j == J_CENTER { pos = free / 2.0 }
        if j == J_END { pos = free }
        if j == J_BETWEEN && n > 1 { g = g + free / float(n - 1) }
    }
    a := gi(i, E_ALIGN)
    sc := gf(i, E_SCROLL)
    c = gi(i, E_FIRST)
    while c >= 0 {
        if (gi(c, E_FLAGS) & F_ABS) != 0 {
            place(c, ix + gf(c, E_AX), iy + gf(c, E_AY) - sc, gf(c, E_W), gf(c, E_H))
        } else {
            cm := gf(c, E_H)
            cc := gf(c, E_W)
            if r { cm = gf(c, E_W)  cc = gf(c, E_H) }
            gr := grow_of(c, r)
            if tgrow > 0.0 && gr > 0.0 { cm = free * gr / tgrow }
            if stretches(c, r, a) { cc = icross }
            off := 0.0
            if a == A_CENTER { off = (icross - cc) / 2.0 }
            if a == A_END { off = icross - cc }
            if r {
                place(c, ix + pos, iy + off, cm, cc)
            } else {
                place(c, ix + off, iy + pos, cc, cm)
            }
            pos = pos + cm + g
        }
        c = gi(c, E_NEXT)
    }
}
